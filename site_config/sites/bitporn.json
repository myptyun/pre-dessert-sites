{
  "id": "bitporn",
  "name": "BitPor",
  "domain": "https://bitporn.eu",
  "encoding": "UTF-8",
  "public": false,
  "schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": false
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true,
    "has_hr": true,
    "has_cover": true
  },
  "category": {
    "movie": [
      {
        "id": 1,
        "cat": "Movies",
        "desc": "电影"
      }
    ],
    "tv": [
      {
        "id": 2,
        "cat": "TV",
        "desc": "电视剧/综艺"
      }
    ],
    "music": [
      {
        "id": 3,
        "cat": "Music",
        "desc": "音乐"
      }
    ],
    "game": [
      {
        "id": 4,
        "cat": "Game",
        "desc": "游戏"
      }
    ],
    "app": [
      {
        "id": 5,
        "cat": "Application",
        "desc": "应用软件"
      }
    ],
    "xxx": [
      {
        "id": 8,
        "cat": "XXX",
        "desc": "成人内容"
      }
    ],
    "book": [
      {
        "id": 9,
        "cat": "Ebook/Manga",
        "desc": "电子书/漫画"
      }
    ],
    "edu": [
      {
        "id": 10,
        "cat": "Education",
        "desc": "教育/教程"
      }
    ],
    "fanres": [
      {
        "id": 11,
        "cat": "FANRES",
        "desc": "粉丝修复/爱好者版本"
      }
    ]
  },
  "requests": {
    "favicon": {
      "parser": "None",
      "method": "GET",
      "path": "/favicon.ico"
    },
    "notice": {
      "parser": "XPath",
      "method": "GET",
      "path": "/articles",
      "fields": {
        "content": {
          "selector": "//article[contains(@class,'article-preview')]"
        }
      }
    },
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "/",
      "fields": {
        "is_login": {
          "selector": "//form[contains(@action,'/logout')]//button",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(注销|Logout)",
                0
              ]
            },
            {
              "name": "replace",
              "args": [
                "注销",
                "true"
              ]
            },
            {
              "name": "replace",
              "args": [
                "Logout",
                "true"
              ]
            }
          ]
        },
        "id": {
          "selector": "//a[contains(@href,'/users/') and (contains(@href,'/conversations') or contains(@class,'username') or contains(@class,'user'))]/@href | //meta[@name='user-login']/@content | //a[contains(@href,'/users/')]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/users/([^/?#]+)/",
                1
              ]
            },
            {
              "name": "strip"
            }
          ]
        },
        "name": {
          "selector": "//nav//a[contains(@href,'/users/') and not(contains(@href,'transactions')) and not(contains(@href,'uploads'))]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/users/([^/]+)/",
                1
              ]
            }
          ]
        },
        "uploaded": {
          "selector": "//li[contains(@class,'ratio-bar__uploaded')]/a/text()[not(parent::time)]",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "//li[contains(@class,'ratio-bar__downloaded')]/a/text()[not(parent::time)]",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "ratio": {
          "selector": "//li[contains(@class,'ratio-bar__ratio')]/a/text()",
          "filters": [
            {
              "name": "replace",
              "args": [
                "∞",
                "0"
              ]
            },
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "strip"
            }
          ]
        },
        "bonus": {
          "selector": "//li[contains(@class,'ratio-bar__points')]/a/text()",
          "filters": [
            {
              "name": "replace",
              "args": [
                " ",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                " ",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "strip"
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/users/{userId}",
      "fields": {
        "level": {
          "selector": "//a[contains(@class, 'user-tag__link')]/@title",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "level_icon": {
          "selector": "//div/article/img/@src"
        },
        "join_at": {
          "selector": "//time[@datetime][1]/@datetime",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        },
        "last_accessed": {
          "selector": "//time[@datetime][last()]/@datetime",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/users/{userId}",
      "disabled_extends": {
        "list": true
      },
      "fields": {
        "count": {
          "selector": "//dt[contains(.,'总做种数量')]/following-sibling::dd[1]/text()",
          "filters": [
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "strip"
            }
          ]
        },
        "size": {
          "selector": "//dt[contains(.,'做种体积')]/following-sibling::dd[1]/text()",
          "filters": [
            {
              "name": "replace",
              "args": [
                " ",
                " "
              ]
            },
            {
              "name": "strip"
            },
            {
              "name": "byte_size"
            }
          ]
        }
      }
    },
    "search": {
      "method": "GET",
      "path": "torrents?perPage=100",
      "params": {
        "name": [
          "{keyword}"
        ]
      },
      "list": {
        "selector": "table.data-table > tbody > tr"
      },
      "fields": {
        "id": {
          "selector": "a.torrent-search--list__name",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "\\d+",
                0
              ]
            }
          ]
        },
        "title": {
          "selector": "a.torrent-search--list__name"
        },
        "details": {
          "selector": "a.torrent-search--list__name",
          "attribute": "href"
        },
        "download": {
          "selector": "a[href*='/torrents/download/']",
          "attribute": "href"
        },
        "date_added": {
          "selector": "td.torrent-search--list__age > time",
          "attribute": "datetime",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        },
        "size": {
          "selector": "td.torrent-search--list__size",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "seeders": {
          "selector": "td.torrent-search--list__seeders > a"
        },
        "leechers": {
          "selector": "td.torrent-search--list__leechers > a"
        },
        "grabs": {
          "selector": "td.torrent-search--list__completed > a"
        },
        "downloadvolumefactor": {
          "case": {
            "i.torrent-icons__freeleech": 0,
            "i.torrent-icons__25percent": 0.75,
            "i.torrent-icons__50percent": 0.5,
            "i.torrent-icons__75percent": 0.25,
            "*": 1
          }
        },
        "uploadvolumefactor": {
          "case": {
            "i.torrent-icons__double-upload": 2,
            "*": 1
          }
        }
      }
    },
    "messages": {
      "parser": "XPath",
      "method": "GET",
      "list": {
        "selector": "//table[contains(@class, 'data-table')]/tbody/tr[.//a[contains(@href,'/conversations/')]] | //a[contains(@href,'/conversations/') and not(contains(@href,'/create'))]/ancestor::tr[1]"
      },
      "fields": {
        "title": {
          "selector": "./td[2]/a[contains(@href,'/conversations/')] | .//a[contains(@href,'/conversations/') and not(contains(@href,'/create'))][1]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "link": {
          "selector": "./td[2]/a[contains(@href,'/conversations/')]/@href | .//a[contains(@href,'/conversations/') and not(contains(@href,'/create'))][1]/@href"
        },
        "id": {
          "selector": "./td[2]/a[contains(@href,'/conversations/')]/@href | .//a[contains(@href,'/conversations/') and not(contains(@href,'/create'))][1]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/conversations/(\\d+)",
                1
              ]
            }
          ]
        },
        "sender": {
          "selector": "./td[1]//span[contains(@class, 'user-tag')]/a | ./td[1]//a[contains(@href,'/users/')] | .//a[contains(@href,'/users/')][1]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "date": {
          "selector": "./td[3]//time/@title | ./td[3]//time/@datetime | ./td[3] | .//time/@title | .//time/@datetime",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "unread": {
          "selector": ".//*[contains(@class,'unread') or contains(@class,'new') or contains(@class,'text-red') or contains(@class,'fa-envelope')]",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        }
      },
      "path": "/users/{userId}/conversations"
    }
  }
}