{
  "id": "eiga",
  "name": "ACM",
  "domain": "https://eiga.moi",
  "additional_domain": [],
  "encoding": "UTF-8",
  "public": false,
  "schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": false
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true,
    "has_hr": false,
    "has_cover": true
  },
  "category": {
    "movie": [
      {
        "id": 1,
        "cat": "Movies",
        "desc": "Movies"
      }
    ],
    "tv": [
      {
        "id": 2,
        "cat": "TV",
        "desc": "TV"
      }
    ],
    "music": [
      {
        "id": 3,
        "cat": "Audio",
        "desc": "Music"
      }
    ]
  },
  "requests": {
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "/",
      "fields": {
        "is_login": {
          "any": [
            {
              "selector": "//a[contains(@href,'/logout')]",
              "filters": [
                {
                  "name": "not_blank"
                }
              ]
            },
            {
              "selector": "//form[contains(@action,'/logout')]",
              "filters": [
                {
                  "name": "not_blank"
                }
              ]
            },
            {
              "selector": "//a[contains(@href,'/users/')]",
              "filters": [
                {
                  "name": "not_blank"
                }
              ]
            }
          ]
        },
        "id": {
          "any": [
            {
              "selector": "//a[contains(@href,'/users/') and contains(@href,'/conversations')][1]/@href",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "/users/([^/?#]+)/conversations",
                    1
                  ]
                },
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "//a[contains(@href,'/users/') and .//span[contains(@class,'text-bold')]][1]/@href",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "/users/([^/?#]+)",
                    1
                  ]
                },
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "//a[contains(@href,'/users/') and not(contains(substring-after(@href,'/users/'),'/')) and not(contains(@href,'?'))][1]/@href",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "/users/([^/?#]+)",
                    1
                  ]
                },
                {
                  "name": "strip"
                }
              ]
            }
          ]
        },
        "name": {
          "selector": "//a[contains(@href,'/users/') and not(contains(substring-after(@href,'/users/'),'/')) and not(contains(@href,'?'))]//span[contains(@class,'text-bold')]/text() | //a[contains(@href,'/users/') and not(contains(substring-after(@href,'/users/'),'/')) and not(contains(@href,'?'))]/text()",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "uploaded": {
          "selector": "//li[contains(@title, '上传')]//a/text()[normalize-space()]",
          "filters": [
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "//li[contains(@title, '下载')]//a/text()[normalize-space()]",
          "filters": [
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "ratio": {
          "selector": "//li[contains(@title, '分享率')]//a/text()[normalize-space()]",
          "filters": [
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            }
          ]
        },
        "bonus": {
          "selector": "//li[contains(@title, '魔力')]//a/text()[normalize-space()]",
          "filters": [
            {
              "name": "replace",
              "args": [
                " ",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                " ",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                " ",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                " ",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "strip"
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/users/{userId}",
      "fields": {
        "level": {
          "selector": "//span[contains(@class,'profile__username')]//a[contains(@class,'user-tag__link')]/@title | //a[contains(@class,'user-tag__link') and contains(@href,'/users/')]/@title",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "level_icon": {
          "selector": "//span[contains(@class,'profile__username')]//img/@src | //a[contains(@class,'user-tag__link') and contains(@href,'/users/')]//img/@src",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "join_at": {
          "selector": "//time[contains(@class,'profile__registration')]/@datetime | //time[contains(@class,'profile__registration')]/@title",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        },
        "last_accessed": {
          "selector": "//dt[contains(normalize-space(.),'上次登录时间') or contains(normalize-space(.),'Last login')]/following-sibling::dd[1]//time/@datetime | //dt[contains(normalize-space(.),'Last action') or contains(normalize-space(.),'最近活动')]/following-sibling::dd[1]//time/@datetime",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            }
          ]
        }
      }
    },
    "notice": {
      "parser": "XPath",
      "method": "GET",
      "path": "/articles",
      "fields": {
        "content": {
          "selector": "//article[contains(@class, 'article-preview')]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/users/{userId}",
      "disabled_extends": {
        "list": true
      },
      "fields": {
        "count": {
          "any": [
            {
              "selector": "//a[contains(@href,'/active?seeding=include')]/ancestor::dt/following-sibling::dd[1]/text()",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    ""
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    ""
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "//li[contains(@class,'ratio-bar__seeding')]//a/text()[normalize-space()]",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    ""
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    ""
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "//dt[.//a[contains(@href,'/active?seeding=include')] or contains(normalize-space(.),'总做种数量')]/following-sibling::dd[1]/text()",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    ""
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    ""
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            }
          ]
        },
        "size": {
          "any": [
            {
              "selector": "//abbr[contains(@title,'做种体积') or contains(@title,'Seeding Size')]/ancestor::dt/following-sibling::dd[1]/text()",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    " "
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    " "
                  ]
                },
                {
                  "name": "byte_size"
                }
              ]
            },
            {
              "selector": "//dt[contains(normalize-space(.),'做种体积') or contains(normalize-space(.),'Seeding Size')]/following-sibling::dd[1]/text()",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    " "
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    " "
                  ]
                },
                {
                  "name": "byte_size"
                }
              ]
            },
            {
              "selector": "//section[.//h2[contains(normalize-space(.),'Traffic')]]//dt[contains(normalize-space(.),'种子 下载')]/following-sibling::dd[1]/text()",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    " "
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    " ",
                    " "
                  ]
                },
                {
                  "name": "byte_size"
                }
              ]
            }
          ]
        }
      }
    },
    "search": {
      "path": "/torrents",
      "params": {
        "name": [
          "{keyword}"
        ],
        "perPage": [
          "25"
        ],
        "search_mode": [
          "0"
        ],
        "notnewword": [
          "1"
        ],
        "view": [
          "card"
        ]
      },
      "list": {
        "selector": "//article[contains(@class,'torrent-card')]"
      },
      "fields": {
        "id": {
          "selector": ".//a[contains(@class,'torrent-card__link')][1]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/torrents/(\\d+)",
                1
              ]
            }
          ]
        },
        "cover": {
          "selector": ".//img[contains(@class,'torrent-card__image')][1]/@src | .//img[contains(@class,'torrent-card__image')][1]/@data-src"
        },
        "title": {
          "selector": ".//a[contains(@class,'torrent-card__link')][1]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "description": {
          "selector": ".//p[contains(@class,'torrent-card__plot')]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "subtitle": {
          "selector": ".//h2[contains(@class,'torrent-card__title')]/a",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "replace",
              "args": [
                "\n",
                " "
              ]
            },
            {
              "name": "replace",
              "args": [
                "\t",
                " "
              ]
            },
            {
              "name": "re_search",
              "args": [
                "/\\s*([^0-9]+?)\\s+(?:19|20)\\d{2}",
                1
              ]
            },
            {
              "name": "strip"
            }
          ]
        },
        "details": {
          "selector": ".//a[contains(@class,'torrent-card__link')][1]/@href"
        },
        "download": {
          "selector": ".//footer[contains(@class,'torrent-card__footer')]//a[contains(@href,'/download/') or contains(@href,'/torrents/download/')][1]/@href"
        },
        "size": {
          "selector": ".//span[contains(@class,'torrent-card__size')][1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "replace",
              "args": [
                " ",
                " "
              ]
            },
            {
              "name": "replace",
              "args": [
                " ",
                " "
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "seeders": {
          "selector": ".//a[contains(@class,'torrent-card__seeds')][1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "re_search",
              "args": [
                "(\\d+)",
                1
              ]
            }
          ]
        },
        "leechers": {
          "selector": ".//a[contains(@class,'torrent-card__leeches')][1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "re_search",
              "args": [
                "(\\d+)",
                1
              ]
            }
          ]
        },
        "grabs": {
          "selector": ".//a[contains(@class,'torrent-card__completed')][1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "re_search",
              "args": [
                "(\\d+)",
                1
              ]
            }
          ]
        },
        "date_added": {
          "selector": ".//footer[contains(@class,'torrent-card__footer')]//time/@datetime | .//footer[contains(@class,'torrent-card__footer')]//time/@title",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            },
            {
              "name": "timezone",
              "args": [
                "+8"
              ]
            }
          ]
        },
        "time": {
          "selector": ".//footer[contains(@class,'torrent-card__footer')]//time/@datetime | .//footer[contains(@class,'torrent-card__footer')]//time/@title",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            },
            {
              "name": "timezone",
              "args": [
                "+8"
              ]
            }
          ]
        },
        "created_at": {
          "selector": ".//footer[contains(@class,'torrent-card__footer')]//time/@datetime | .//footer[contains(@class,'torrent-card__footer')]//time/@title",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            },
            {
              "name": "timezone",
              "args": [
                "+8"
              ]
            }
          ]
        },
        "category": {
          "selector": ".//span[contains(@class,'torrent-card__category')][1]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        }
      },
      "parser": "XPath",
      "method": "GET",
      "disabled_extends": {
        "fields": true,
        "field": true
      }
    },
    "messages": {
      "parser": "XPath",
      "method": "GET",
      "list": {
        "selector": "//table[contains(@class,'data-table')]/tbody/tr[.//a[contains(@href,'/conversations/')]]"
      },
      "fields": {
        "id": {
          "selector": "./td[2]/a[contains(@href,'/conversations/')]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/conversations/(\\d+)",
                1
              ]
            }
          ]
        },
        "title": {
          "selector": "./td[2]/a[contains(@href,'/conversations/')]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "link": {
          "selector": "./td[2]/a[contains(@href,'/conversations/')]/@href"
        },
        "sender": {
          "selector": "./td[1]//span[contains(@class,'user-tag')]/a | ./td[1]//a[contains(@href,'/users/')]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "date": {
          "selector": "./td[3]//time/@title | ./td[3]//time/@datetime | ./td[3]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "unread": {
          "selector": "./td[5]//i[not(contains(@class,'text-green')) and (contains(@title,'未读') or contains(@title,'Unread') or contains(@class,'fa-envelope'))] | ./td[contains(@class,'unread')]",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        }
      },
      "path": "/users/{userId}/conversations"
    }
  },
  "first_page_offset": 1
}
