{
  "id": "exoticaz",
  "name": "exoticaz",
  "domain": "https://exoticaz.to",
  "encoding": "UTF-8",
  "public": false,
  "reuse_schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": true
  },
  "meta": {
    "has_free": true,
    "has_cover": true
  },
  "category": {
    "9kg": [
      {
        "id": "Video Clip",
        "cat": "AV/Video Clip",
        "desc": "Video Clip"
      },
      {
        "id": "Video Pack",
        "cat": "AV/Video Pack",
        "desc": "Video Pack"
      },
      {
        "id": "Siterip Pack",
        "cat": "AV/cate_level2_desc",
        "desc": "Siterip Pack"
      },
      {
        "id": "Pornstar Pack",
        "cat": "AV/Pornstar Pack",
        "desc": "Pornstar Pack"
      },
      {
        "id": "DVD",
        "cat": "AV/DVD",
        "desc": "DVD"
      },
      {
        "id": "BluRay",
        "cat": "AV/BluRay",
        "desc": "BluRay"
      },
      {
        "id": "Photo Pack",
        "cat": "AV/Photo Pack",
        "desc": "Photo Pack"
      },
      {
        "id": "Books &amp; Magazines",
        "cat": "AV/Books",
        "desc": "Books &amp; Magazines"
      }
    ]
  },
  "requests": {
    "search": {
      "path": "/torrents",
      "list": {
        "selector": "div.table-responsive table tbody tr:has(a.torrent-link[href*='/torrent/'])"
      },
      "fields": {
        "id": {
          "selector": "a.torrent-link[href*='/torrent/']",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/torrent/(\\d+)",
                1
              ]
            }
          ]
        },
        "title": {
          "any": [
            {
              "selector": "a.torrent-link[title]",
              "attribute": "title",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "a.torrent-link",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "td:nth-child(2) img[alt]",
              "attribute": "alt",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            }
          ]
        },
        "category": {
          "any": [
            {
              "selector": "td:nth-child(1) i.category-icon[title]",
              "attribute": "title",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "td:nth-child(2) span[title]",
              "attribute": "title",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            }
          ]
        },
        "details": {
          "selector": "a.torrent-link[href*='/torrent/']",
          "attribute": "href",
          "filters": [
            {
              "name": "replace",
              "args": [
                "https://exoticaz.to/",
                ""
              ]
            }
          ]
        },
        "download": {
          "selector": "a[href*='/download/torrent/'][title*='Download'], a[href*='/download/torrent/']",
          "attribute": "href"
        },
        "size": {
          "selector": "td:nth-child(5)",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "replace",
              "args": [
                " ",
                " "
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "seeders": {
          "selector": "td:nth-child(6)",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "leechers": {
          "selector": "td:nth-child(7)",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "grabs": {
          "selector": "td:nth-child(8)",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "labels": {
          "selector": "td:nth-child(2) div.tags a.tag, td:nth-child(2) div.tags div.tag",
          "array": true,
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "cover": {
          "any": [
            {
              "selector": "td:nth-child(2) div.screen-image img",
              "attribute": "src"
            },
            {
              "selector": "td:nth-child(2) img",
              "attribute": "src"
            }
          ]
        },
        "downloadvolumefactor": {
          "case": {
            "i.fa.fa-star.text-yellow, i.fa-star.text-yellow, [title*='Free Download']": 0,
            "i.fa-star-half-alt.text-pink, [title*='50%']": 0.5,
            "*": 1
          }
        },
        "uploadvolumefactor": {
          "case": {
            "i.fa.fa-gem.text-green, i.fa-gem.text-green, [title*='Double Upload']": 2,
            "*": 1
          }
        },
        "description": {
          "any": [
            {
              "selector": "td:nth-child(2) img[alt]",
              "attribute": "alt",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "a.torrent-link[title]",
              "attribute": "title",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            }
          ]
        },
        "date_elapsed": {
          "selector": "td:nth-child(4)",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "uploader": {
          "selector": "td:nth-child(2) a[href*='/profile/'][title]",
          "attribute": "title",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "files": {
          "selector": "td:nth-child(2) i[title*='files'], td:nth-child(2) [title*='Files']",
          "attribute": "title",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d+)",
                1
              ]
            }
          ]
        }
      },
      "parser": "CssSelector",
      "method": "GET"
    },
    "messages": {
      "parser": "XPath",
      "method": "GET",
      "path": "/messenger",
      "list": {
        "selector": "//table//tr[position() > 1][.//td[a[contains(@href, 'messenger')]]]"
      },
      "params": {
        "page": [
          "{page}"
        ]
      },
      "fields": {
        "title": {
          "selector": "td[2]/a/text()"
        },
        "link": {
          "selector": "td[2]/a/@href"
        },
        "id": {
          "selector": "td[2]/a/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "id=(\\d+)",
                1
              ]
            }
          ]
        },
        "date": {
          "any": [
            {
              "selector": "td[4]/span/text()"
            },
            {
              "selector": "td[4]/text()"
            }
          ]
        }
      }
    },
    "message_detail": {
      "parser": "XPath",
      "method": "GET",
      "path": "",
      "fields": {
        "title": {
          "selector": "//h1/text()|//div[@class='layui-card-header']/span[1]/text()"
        },
        "date": {
          "selector": "//h1/following-sibling::table[.//tr/td[@class='colhead']]//tr[2]/td[2]|//div[@class='layui-card-header']/span[2]/span[2]"
        },
        "content": {
          "selector": "//h1/following-sibling::table[.//tr/td[@class='colhead']]//tr[3]/td|//div[contains(@class,'layui-card-body')]"
        }
      }
    },
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "/profile/{userId}",
      "fields": {
        "is_login": {
          "any": [
            {
              "selector": "//a[contains(@href,'/logout') or contains(@href,'logout')]/@href",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "(logout)",
                    1
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    "logout",
                    "true"
                  ]
                }
              ]
            },
            {
              "selector": "//form[contains(@action,'/logout') or contains(@action,'logout')]/@action",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "(logout)",
                    1
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    "logout",
                    "true"
                  ]
                }
              ]
            }
          ]
        },
        "id": {
          "any": [
            {
              "selector": "//a[@id='navbar-dropdown-user']/text()",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "//title/text()",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "^\\s*([^\\s<]+)\\s+-\\s+ExoticaZ",
                    1
                  ]
                }
              ]
            }
          ]
        },
        "name": {
          "any": [
            {
              "selector": "//a[@id='navbar-dropdown-user']/text()",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "//title/text()",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "^\\s*([^\\s<]+)\\s+-\\s+ExoticaZ",
                    1
                  ]
                }
              ]
            }
          ]
        },
        "uploaded": {
          "selector": "//tr[td[1][normalize-space()='Uploaded']]/td[2]/text()[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "//tr[td[1][normalize-space()='Downloaded']]/td[2]/text()[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "ratio": {
          "selector": "//tr[td[1][normalize-space()='Ratio']]/td[2]/text()[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            },
            {
              "name": "re_search",
              "args": [
                "([\\d.]+)",
                1
              ]
            }
          ]
        },
        "bonus": {
          "any": [
            {
              "selector": "//tr[td[1][contains(normalize-space(),'Bonus Points')]]/td[2]/text()[1]",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                },
                {
                  "name": "re_search",
                  "args": [
                    "([\\d.]+)",
                    1
                  ]
                }
              ]
            },
            {
              "selector": "//a[contains(@href,'/bonus') and contains(normalize-space(.),'Bonus')]/following-sibling::text()[1]",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                },
                {
                  "name": "re_search",
                  "args": [
                    "([\\d.]+)",
                    1
                  ]
                }
              ]
            },
            {
              "selector": "//div[contains(@class,'ratio-bar')]//div[contains(.,'Bonus:')]/text()[last()]",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                },
                {
                  "name": "re_search",
                  "args": [
                    "([\\d.]+)",
                    1
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/profile/{userId}",
      "fields": {
        "level": {
          "any": [
            {
              "selector": "//tr[td[1][normalize-space()='Rank']]/td[2]//*[contains(@class,'user-group')]/text()",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "//div[contains(@class,'ratio-bar')]//span[contains(@class,'user-group')][2]/text()",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            }
          ]
        },
        "join_at": {
          "selector": "//tr[td[1][normalize-space()='Joined']]/td[2]/text()[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "re_search",
              "args": [
                "^(\\d{2}\\s+[A-Za-z]{3}\\s+\\d{4}\\s+\\d{2}:\\d{2}\\s+[ap]m)",
                1
              ]
            },
            {
              "name": "timestamp",
              "args": [
                "02 Jan 2006 03:04 pm"
              ]
            },
            {
              "name": "timezone",
              "args": [
                "+8"
              ]
            }
          ]
        },
        "last_accessed": {
          "selector": "//tr[td[1][contains(normalize-space(),'Last Access')]]/td[2]/text()[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "re_search",
              "args": [
                "^(\\d{2}\\s+[A-Za-z]{3}\\s+\\d{4}\\s+\\d{2}:\\d{2}\\s+[ap]m)",
                1
              ]
            },
            {
              "name": "timestamp",
              "args": [
                "02 Jan 2006 03:04 pm"
              ]
            },
            {
              "name": "timezone",
              "args": [
                "+2"
              ]
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/profile/{userId}/active",
      "list": {
        "selector": "//table//tr[td]"
      },
      "fields": {
        "size": {
          "selector": "/td[2]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "replace",
              "args": [
                " ",
                " "
              ]
            },
            {
              "name": "re_search",
              "args": [
                "([\\d,.]+\\s*[KMGTPE]?i?B)\\s*$",
                1
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        }
      }
    }
  }
}
