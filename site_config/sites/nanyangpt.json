{
  "id": "nanyangpt",
  "name": "南洋PT",
  "domain": "https://nanyangpt.com",
  "public": false,
  "schema": "NexusPHP",
  "required": {
    "cookie": true
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true
  },
  "category": {
    "movie": [
      {
        "id": 401,
        "cat": "Movies",
        "desc": "Movies/电影"
      }
    ],
    "tv": [
      {
        "id": 406,
        "cat": "TV/Documentary",
        "desc": "Documentaries/纪录片"
      },
      {
        "id": 403,
        "cat": "TV/Anime",
        "desc": "Animations/动漫"
      },
      {
        "id": 402,
        "cat": "TV",
        "desc": "TV Series/连续剧"
      },
      {
        "id": 404,
        "cat": "TV",
        "desc": "TV Shows/综艺"
      }
    ]
  },
  "requests": {
    "search": {
      "fields": {
        "labels": {
          "selector": "td.embedded > span[title]",
          "array": true
        },
        "description": {
          "selector": "td.embedded",
          "remove": "span,a,img,font,b,br",
          "contents": -1
        },
        "hr_days": {
          "filters": [
            {
              "name": "constant",
              "args": "1"
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/getusertorrentlistajax.php?userid={userId}&type=seeding",
      "headers": {
        "Referer": "{domain}/userdetails.php?id={userId}"
      },
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "count": {
          "selector": "//body",
          "filters": [
            {
              "name": "re_search",
              "args": ["<b>(\\d+)</b>\\s*条记录", 1]
            }
          ]
        },
        "size": {
          "selector": "//body",
          "filters": [
            {
              "name": "re_search",
              "args": ["条记录(?:\\s|&nbsp;| )*-(?:\\s|&nbsp;| )*([0-9.]+(?:\\s|&nbsp;| )*(?:[KMGTPE]i?B|[KMGTPE]B))", 1]
            },
            {
              "name": "strip"
            },
            {
              "name": "byte_size"
            }
          ]
        }
      }
    }
  },
  "my_hr": {
    "path": "/myhr.php?status=1"
  }
}