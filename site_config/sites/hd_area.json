{
  "id": "hd_area",
  "name": "好大",
  "domain": "https://hdarea.club",
  "public": false,
  "schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": true
  },
  "meta": {
    "has_free": true,
    "has_2x_free": true
  },
  "category": {
    "movie": [
      {
        "id": 300,
        "cat": "Movies/UHD",
        "desc": "Movies UHD-4K"
      },
      {
        "id": 401,
        "cat": "Movies/BluRay",
        "desc": "Movies Blu-ray"
      },
      {
        "id": 415,
        "cat": "Movies/HD",
        "desc": "Movies REMUX"
      },
      {
        "id": 416,
        "cat": "Movies/3D",
        "desc": "Movies 3D"
      },
      {
        "id": 410,
        "cat": "Movies/HD",
        "desc": "Movies 1080p"
      },
      {
        "id": 411,
        "cat": "Movies/HD",
        "desc": "Movies 720p"
      },
      {
        "id": 414,
        "cat": "Movies/DVD",
        "desc": "Movies DVD"
      },
      {
        "id": 412,
        "cat": "Movies/WEB-DL",
        "desc": "Movies WEB-DL"
      },
      {
        "id": 413,
        "cat": "Movies/HD",
        "desc": "Movies HDTV"
      },
      {
        "id": 417,
        "cat": "Movies/Other",
        "desc": "Movies iPad"
      }
    ],
    "tv": [
      {
        "id": 404,
        "cat": "TV/Documentary",
        "desc": "Documentaries"
      },
      {
        "id": 405,
        "cat": "TV/Anime",
        "desc": "Animations"
      },
      {
        "id": 402,
        "cat": "TV",
        "desc": "TV Series"
      },
      {
        "id": 403,
        "cat": "TV",
        "desc": "TV Shows"
      }
    ]
  },
  "requests": {
    "search": {
      "fields": {
        "id": {
          "selector": "a[href*='details.php?id=']",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "\\d+",
                0
              ]
            }
          ]
        },
        "category": {
          "selector": "a[href*='?cat=']",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "cat=(.*)",
                1
              ]
            }
          ]
        },
        "cover": {
          "selector": "td:nth-child(2) img.torrent-poster-thumb",
          "attribute": "data-src"
        },
        "title": {
          "any": [
            {
              "selector": "td:nth-child(3) a[title][href*='details.php?id=']",
              "attribute": "title"
            },
            {
              "selector": "td:nth-child(3) a[href*='details.php?id=']"
            }
          ]
        },
        "details": {
          "selector": "td:nth-child(3) a[href*='details.php?id=']",
          "attribute": "href"
        },
        "download": {
          "selector": "td:nth-child(3) a[href*='download.php?id=']",
          "attribute": "href"
        },
        "size": {
          "selector": "td:nth-child(6):not(.embedded)",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "grabs": {
          "selector": "td:nth-child(9):not(.embedded)"
        },
        "seeders": {
          "selector": "td:nth-child(7):not(.embedded)"
        },
        "leechers": {
          "selector": "td:nth-child(8):not(.embedded)"
        },
        "downloadvolumefactor": {
          "any": [
            {
              "selector": "img.pro_free,img.pro_free2up",
              "attribute": "class",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0,
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "img.pro_50pctdown,img.pro_50pctdown2up",
              "attribute": "class",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0.5,
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "img.pro_30pctdown",
              "attribute": "class",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0.3,
                    1
                  ]
                }
              ]
            }
          ]
        },
        "uploadvolumefactor": {
          "any": [
            {
              "selector": "img.pro_50pctdown2up,img.pro_free2up,img.pro_2up",
              "attribute": "class",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    2,
                    1
                  ]
                }
              ]
            }
          ]
        },
        "description": {
          "selector": "td:nth-child(3) td.embedded",
          "remove": "span,a,img,font,b,br",
          "contents": -1,
          "filters": [
            {
              "name": "replace",
              "args": [
                "()",
                ""
              ]
            }
          ]
        },
        "labels": {
          "selector": "td:nth-child(2) > span[title='']",
          "array": true
        },
        "imdb_id": {
          "any": [
            {
              "selector": "a[href*='imdb.com/title/tt']",
              "attribute": "href",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "(tt\\d+)",
                    1
                  ]
                }
              ]
            },
            {
              "selector": "span[data-imdbid]",
              "attribute": "data-imdbid",
              "filters": [
                {
                  "name": "pad_zero",
                  "args": 7
                },
                {
                  "name": "append_left",
                  "args": "tt"
                }
              ]
            },
            {
              "selector": "label[data-imdbid]",
              "attribute": "data-imdbid",
              "filters": [
                {
                  "name": "pad_zero",
                  "args": 7
                },
                {
                  "name": "append_left",
                  "args": "tt"
                }
              ]
            },
            {
              "selector": "a[href*='search_area=4']",
              "attribute": "href",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "search=(\\d+)",
                    1
                  ]
                },
                {
                  "name": "pad_zero",
                  "args": 7
                },
                {
                  "name": "append_left",
                  "args": "tt"
                }
              ]
            }
          ]
        },
        "douban_id": {
          "any": [
            {
              "selector": "a[href*='movie.douban.com/subject/']",
              "attribute": "href",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "(\\d+)",
                    0
                  ]
                }
              ]
            },
            {
              "selector": "span[data-doubanid]",
              "attribute": "data-doubanid"
            },
            {
              "selector": "label[data-doubanid]",
              "attribute": "data-doubanid"
            },
            {
              "selector": "a[href*='search_area=5']",
              "attribute": "href",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "search=(\\d+)",
                    1
                  ]
                }
              ]
            }
          ]
        },
        "date_elapsed": {
          "selector": "td:nth-child(5):not(.embedded) > span"
        },
        "date_added": {
          "selector": "td:nth-child(5):not(.embedded) > span",
          "attribute": "title",
          "filters": [
            {
              "name": "timestamp",
              "args": [
                "2006-01-02 15:04:05"
              ]
            },
            {
              "name": "timezone",
              "args": [
                "-8"
              ]
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/mybonus.php",
      "disabled_extends": {
        "list": true
      },
      "fields": {
        "count": {
          "any": [
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "当前状态：正在做种\\s*<b>(\\d+)</b>\\s*个有效资源",
                    1
                  ]
                }
              ]
            },
            {
              "selector": "//div[contains(., '当前状态：正在做种') and contains(., '个有效资源')]//b[last()]",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "//div[contains(., '基础数量分')]//b[contains(following-sibling::text()[1], '个有效资源')]",
              "filters": [
                {
                  "name": "strip"
                }
              ]
            }
          ]
        },
        "size": {
          "any": [
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "当前状态：做种总积\\s*<b>([\\d.]+\\s*GB)</b>",
                    1
                  ]
                },
                {
                  "name": "byte_size"
                }
              ]
            },
            {
              "selector": "//div[contains(., '当前状态：做种总积')]//b[1]",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "byte_size"
                }
              ]
            },
            {
              "selector": "//div[contains(., '体积与稀缺分')]//b[contains(following-sibling::text()[1], 'GB')]",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "byte_size"
                }
              ]
            }
          ]
        }
      }
    },
    "sign_in": {
      "path": "/sign_in.php",
      "method": "POST",
      "form_data": {
        "action": [
          "sign_in"
        ]
      },
      "fields": {
        "signed_in": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "regex",
              "args": "(已连续签到\\d+天|此次签到您获得了\\d+魔力值奖励|请不要重复签到|签到成功|签到已得|簽到已得|今日已签到)"
            }
          ]
        }
      },
      "parser": "XPath"
    },
    "user_basic_info": {
      "fields": {
        "signed_in": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "regex",
              "args": "__MSGO_HDAREA_NEVER_TRUST_HOMEPAGE_SIGNED_IN__"
            }
          ]
        }
      }
    }
  }
}
