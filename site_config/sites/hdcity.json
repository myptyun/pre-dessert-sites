{
  "id": "hdcity",
  "name": "城市",
  "domain": "https://hdcity.work",
  "public": false,
  "schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": true
  },
  "meta": {
    "has_free": false,
    "has_2x_free": false,
    "has_hr": false
  },
  "category": {
    "movie": [
      {
        "id": 401,
        "cat": "Movies",
        "desc": "Movies/电影"
      }
    ],
    "tv": [
      {
        "id": 404,
        "cat": "TV/Documentary",
        "desc": "Documentaries/纪录片"
      },
      {
        "id": 405,
        "cat": "TV/Anime",
        "desc": "Animations/动漫"
      },
      {
        "id": 402,
        "cat": "TV",
        "desc": "TV Series/连续剧"
      },
      {
        "id": 403,
        "cat": "TV",
        "desc": "TV Shows/综艺"
      }
    ]
  },
  "requests": {
    "search": {
      "parser": "CssSelector",
      "method": "GET",
      "path": "/pt",
      "params": {
        "iwannaseethis": [
          "{keyword}"
        ]
      },
      "list": {
        "selector": "div.tr_normal.mitem, div.tr_free.mitem, div.tr_twoup.mitem, div.tr_important.mitem"
      },
      "fields": {
        "id": {
          "selector": "a[href^=\"t-\"]",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "t-(\\d+)",
                1
              ]
            }
          ]
        },
        "category": {
          "selector": ".mcontent",
          "attribute": "style",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "category/modern/(\\d+)\\.png",
                1
              ]
            }
          ]
        },
        "cover": {
          "selector": ".mcontent > img[title=\"Poster\"], .mcontent img[title=\"Poster\"]",
          "attribute": "src"
        },
        "title": {
          "any": [
            {
              "selector": ".mtop a[href^=\"t-\"] strong"
            },
            {
              "selector": ".mtitle a[href^=\"t-\"]"
            },
            {
              "selector": "a[href^=\"t-\"] strong"
            },
            {
              "selector": "a[href^=\"t-\"]"
            }
          ]
        },
        "details": {
          "selector": "a[href^=\"t-\"]",
          "attribute": "href"
        },
        "download": {
          "selector": "a[href^=\"download?id=\"]",
          "attribute": "href"
        },
        "size": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "sd_storage</i>\\s*([\\d.,]+\\s*[KMGTP]?i?B)",
                1
              ]
            },
            {
              "name": "strip"
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "seeders": {
          "selector": ".mbottom a[title=\"种子数\"] font, .mbottom a[href*=\"dllist=1#seeders\"] font, .mbottom a[title=\"种子数\"]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d+)",
                1
              ]
            }
          ]
        },
        "leechers": {
          "selector": ".mbottom a[title=\"下载数\"] font, .mbottom a[href*=\"dllist=1#leechers\"] font, .mbottom a[title=\"下载数\"]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d+)",
                1
              ]
            }
          ]
        },
        "grabs": {
          "selector": ".mbottom a[title=\"完成数\"], .mbottom a[href^=\"viewsnatches?id=\"]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d+)",
                1
              ]
            }
          ]
        },
        "date_added": {
          "selector": ".mtop div:nth-child(2)",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})",
                1
              ]
            },
            {
              "name": "timestamp"
            }
          ]
        },
        "description": {
          "selector": ".mdesc"
        },
        "labels": {
          "selector": ".mtags span[title=\"Tag\"], .mtags img[title], .mtags i[title]",
          "attribute": "title",
          "array": true
        },
        "hr_days": {
          "filters": [
            {
              "name": "constant",
              "args": "1"
            }
          ]
        }
      },
      "disabled_extends": {
        "fields": true,
        "field": true
      }
    },
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "/userdetails",
      "fields": {
        "is_login": {
          "selector": "//a[contains(@href, 'logout')]",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "any": [
            {
              "selector": "//div[contains(@class,'text')][b[normalize-space()='ID']]/text()[normalize-space()][1]",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "(\\d+)",
                    1
                  ]
                }
              ]
            },
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "<b>ID</b>\\s*(?:&nbsp;|\\s)*([0-9]+)",
                    1
                  ]
                }
              ]
            },
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "getusertorrentlistajax\\('([0-9]+)'\\s*,\\s*'seeding'",
                    1
                  ]
                }
              ]
            }
          ]
        },
        "name": {
          "any": [
            {
              "selector": "//div[@id='bottomnav']//a[contains(@href, 'userdetails')]/strong/text()"
            },
            {
              "selector": "//td[.//div[contains(@class,'text')][b[normalize-space()='ID']]]/preceding-sibling::td[1]//span/text()"
            },
            {
              "selector": "//title/text()",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "市民详情 - ([^-]+) -",
                    1
                  ]
                },
                {
                  "name": "strip"
                }
              ]
            }
          ]
        },
        "level": {
          "selector": "//div[@id='bottomnav']//a[contains(@href, 'userdetails')]/text()[normalize-space()]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "\\[(.*?)\\]",
                1
              ]
            }
          ]
        },
        "share_ratio": {
          "any": [
            {
              "selector": "//i[@title='分享率：']/following-sibling::text()[1]",
              "filters": [
                {
                  "name": "replace",
                  "args": [
                    "---",
                    "null"
                  ]
                },
                {
                  "name": "strip"
                }
              ]
            },
            {
              "selector": "//div[@class='text']/strong[contains(text(), '分享率')]/following-sibling::text()[1]",
              "filters": [
                {
                  "name": "replace",
                  "args": [
                    "---",
                    "null"
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    ":",
                    ""
                  ]
                },
                {
                  "name": "strip"
                }
              ]
            }
          ]
        },
        "uploaded": {
          "any": [
            {
              "selector": "//div[@class='text']/strong[contains(text(), '上传量')]/following-sibling::text()[1]",
              "filters": [
                {
                  "name": "replace",
                  "args": [
                    ":",
                    ""
                  ]
                },
                {
                  "name": "strip"
                },
                {
                  "name": "byte_size"
                }
              ]
            },
            {
              "selector": "//i[contains(@title, '上传')]/following-sibling::text()[1]",
              "filters": [
                {
                  "name": "byte_size"
                }
              ]
            },
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "上传量</strong>[:：]\\s*([0-9.,]+\\s*[KMGTPE]?i?B|[0-9.,]+\\s*[KMGTPE]?B)",
                    1
                  ]
                },
                {
                  "name": "byte_size"
                }
              ]
            }
          ]
        },
        "downloaded": {
          "any": [
            {
              "selector": "//div[@class='text']/strong[contains(text(), '下载量')]/following-sibling::text()[1]",
              "filters": [
                {
                  "name": "replace",
                  "args": [
                    ":",
                    ""
                  ]
                },
                {
                  "name": "strip"
                },
                {
                  "name": "byte_size"
                }
              ]
            },
            {
              "selector": "//i[contains(@title, '下载')]/following-sibling::text()[1]",
              "filters": [
                {
                  "name": "byte_size"
                }
              ]
            },
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "下载量</strong>[:：]\\s*([0-9.,]+\\s*[KMGTPE]?i?B|[0-9.,]+\\s*[KMGTPE]?B)",
                    1
                  ]
                },
                {
                  "name": "byte_size"
                }
              ]
            }
          ]
        },
        "bonus": {
          "any": [
            {
              "selector": "//div[@class='text']/b[contains(text(), '魅力值')]/following-sibling::text()[1]",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "//a[contains(@href,'mybonus')]/text()",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "([\\d,.]+)",
                    1
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            }
          ]
        },
        "join_date": {
          "selector": "//div[@class='text']/b[contains(text(), '加入日期')]/following-sibling::text()[1]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d{4}-\\d{2}-\\d{2})",
                1
              ]
            }
          ]
        },
        "seeding_count": {
          "any": [
            {
              "selector": "//span[contains(@title,'当前做种')]/text()",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "title=[\"\\']当前做种[\"\\'][^>]*>\\s*([0-9,]+)",
                    1
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            }
          ]
        },
        "seed_count": {
          "any": [
            {
              "selector": "//span[contains(@title,'当前做种')]/text()",
              "filters": [
                {
                  "name": "strip"
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "title=[\"\\']当前做种[\"\\'][^>]*>\\s*([0-9,]+)",
                    1
                  ]
                },
                {
                  "name": "replace",
                  "args": [
                    ",",
                    ""
                  ]
                }
              ]
            }
          ]
        },
        "seeding_size": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "constant",
              "args": "0"
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/getusertorrentlistajax.php?userid={userId}&type=seeding",
      "headers": {
        "Referer": "{domain}/userdetails?id={userId}"
      },
      "disabled_extends": {
        "headers": true
      },
      "list": {
        "selector": "//tr[position()>1]"
      },
      "fields": {
        "count": {
          "selector": "//body",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "<b>(\\d+)</b>\\s*条记录",
                1
              ]
            },
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            }
          ]
        },
        "size": {
          "selector": "./td[3]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "byte_size"
            }
          ]
        }
      }
    },
    "sign_in": {
      "path": "/sign",
      "method": "GET",
      "form_data": {
        "action": [
          "sign_in"
        ]
      }
    },
    "messages": {
      "parser": "XPath",
      "method": "GET",
      "path": "/messages.php",
      "params": {
        "action": [
          "viewmailbox"
        ],
        "box": [
          "1"
        ],
        "page": [
          "{page}"
        ]
      },
      "list": {
        "selector": "//table//tr[.//a[contains(@href,'action=viewmessage')]]"
      },
      "fields": {
        "title": {
          "selector": ".//a[contains(@href,'action=viewmessage')][1]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "link": {
          "selector": ".//a[contains(@href,'action=viewmessage')][1]/@href"
        },
        "id": {
          "selector": ".//a[contains(@href,'action=viewmessage')][1]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "id=(\\d+)",
                1
              ]
            }
          ]
        },
        "sender": {
          "selector": "./td[1]//a | ./td[2]//a[not(contains(@href,'action=viewmessage'))][1]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "date": {
          "selector": "./td[last()]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "unread": {
          "selector": ".//*[contains(@class,'unread') or contains(@class,'new') or contains(@src,'unread') or contains(@alt,'Unread')]",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        }
      }
    }
  }
}
