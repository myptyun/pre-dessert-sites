  "requests": {
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "/t",
      "fields": {
        "is_login": {
          "selector": "//form[contains(@action, 'lout.php')] | //a[contains(@class, 'uname') and contains(@href, '/u/')]",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "//a[contains(@class, 'uname') and contains(@href, '/u/')]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/u/(\\d+)",
                1
              ]
            }
          ]
        },
        "name": {
          "selector": "//a[contains(@class, 'uname') and contains(@href, '/u/')]/text()"
        },
        "uploaded": {
          "selector": "//div[normalize-space()='Uploaded']/following-sibling::text()[normalize-space()][1]",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "//div[normalize-space()='Downloaded']/following-sibling::text()[normalize-space()][1]",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "ratio": {
          "selector": "//span[contains(@class, 'c_ratio')]/text()[normalize-space()]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        },
        "bonus": {
          "selector": "//a[contains(@href, 'mybonus.php')]/text()[normalize-space()]",
          "filters": [
            {
              "name": "strip"
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/user.php?u={userId}",
      "fields": {
        "level": {
          "selector": "//span[contains(@class, 'up-class-badge')]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(Power User|User|VIP|Uploader|Moderator|Administrator|Sysop)",
                1
              ]
            },
            {
              "name": "strip"
            }
          ]
        },
        "join_at": {
          "selector": "//span[contains(text(), 'Join Date')]/../span[contains(@class, 'up-field-value')]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})",
                1
              ]
            },
            {
              "name": "timestamp"
            }
          ]
        },
        "last_accessed": {
          "selector": "//span[contains(text(), 'Last Seen')]/../span[contains(@class, 'up-field-value')]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})",
                1
              ]
            },
            {
              "name": "timestamp"
            }
          ]
        }
      }
    },
    "search": {
      "parser": "CssSelector",
      "method": "GET",
      "path": "/t",
      "params": {
        "q": [
          "{keyword}"
        ]
      },
      "disabled_extends": {
        "list": true,
        "fields": true
      },
      "list": {
        "selector": "table#torrents tr:has(a[href^='/download.php/'])"
      },
      "fields": {
        "id": {
          "selector": "td:nth-child(2) a[href^='/t/']",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/t/(\\d+)",
                1
              ]
            }
          ]
        },
        "category": {
          "selector": "td:nth-child(1)",
          "attribute": "class",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "p(\\d+)",
                1
              ]
            }
          ]
        },
        "title": {
          "selector": "td:nth-child(2) a[href^='/t/']"
        },
        "details": {
          "selector": "td:nth-child(2) a[href^='/t/']",
          "attribute": "href"
        },
        "download": {
          "selector": "a[href^='/download.php/']",
          "attribute": "href"
        },
        "size": {
          "selector": "td:nth-child(6)",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "grabs": {
          "selector": "td:nth-child(7)"
        },
        "seeders": {
          "selector": "td:nth-child(8)"
        },
        "leechers": {
          "selector": "td:nth-child(9)"
        },
        "description": {
          "selector": "td:nth-child(2) div.sub"
        },
        "labels": {
          "selector": "td:nth-child(2) span.tag",
          "array": true
        },
        "hr_days": {
          "filters": [
            {
              "name": "constant",
              "args": "1"
            }
          ]
        }
      }
    },
    "details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/t/{id}",
      "disabled_extends": {
        "fields": true
      },
      "fields": {
        "cover": {
          "selector": "//img[contains(@style, 'img.localcdn.net/m/')]/@style",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "url\\((https?://img\\.localcdn\\.net/m/[^)]+)\\)",
                1
              ]
            }
          ]
        },
        "imdb_id": {
          "selector": "//a[contains(@href, 'imdb.com/title/')]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(tt\\d+)",
                1
              ]
            }
          ]
        },
        "tmdb_id": {
          "selector": "//a[contains(@href, 'themoviedb.org/movie/') or contains(@href, 'themoviedb.org/tv/')]/@href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "themoviedb\\.org/(?:movie|tv)/(\\d+)",
                1
              ]
            }
          ]
        },
        "date_added": {
          "selector": "//span[contains(@class, 'elapsedDate') and @title][1]/@title",
          "filters": [
            {
              "name": "timestamp"
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/user.php?u={userId}",
      "disabled_extends": {
        "headers": true,
        "list": true
      },
      "fields": {
        "count": {
          "selector": "//span[contains(text(), 'Seeding')]/../span[contains(@class, 'up-field-value')]",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(\\d+)",
                1
              ]
            }
          ]
        },
        "size": {
          "selector": "//body",
          "filters": [
            {
              "name": "constant",
              "args": "0"
            }
          ]
        }
      }
    }
  },
  "my_hr": {
    "path": "/myhr.php?status=1"
  }
}